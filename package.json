{
  "name": "markflow-markdown-editor",
  "displayName": "MarkFlow – Notion-like Markdown Editor",
  "description": "Edit Markdown files in a Notion-like WYSIWYG editor. Every .md file opens rendered, editable, and saves back as plain Markdown.",
  "version": "0.2.1",
  "publisher": "srivathsanvenkateswaran",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/srivathsanvenkateswaran/Markflow"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "notion",
    "editor",
    "preview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "markflow.editor",
        "displayName": "MarkFlow Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "markflow.openSource",
        "title": "MarkFlow: Open Markdown Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markflow.openWysiwyg",
        "title": "MarkFlow: Open with MarkFlow",
        "icon": "$(open-preview)"
      },
      {
        "command": "markflow.toggleStyle",
        "title": "MarkFlow: Toggle Preview Style (VS Code / Notion)",
        "icon": "$(color-mode)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markflow.openSource",
          "when": "activeCustomEditorId == markflow.editor",
          "group": "navigation"
        },
        {
          "command": "markflow.openWysiwyg",
          "when": "resourceLangId == markdown && activeCustomEditorId != markflow.editor",
          "group": "navigation"
        },
        {
          "command": "markflow.toggleStyle",
          "when": "activeCustomEditorId == markflow.editor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MarkFlow",
      "properties": {
        "markflow.defaultStyle": {
          "type": "string",
          "enum": ["vscode", "notion"],
          "enumDescriptions": [
            "Typography matching VS Code's built-in Markdown preview, full-width layout",
            "Notion-like typography with larger headings and a document feel"
          ],
          "default": "vscode",
          "description": "Default rendering style for MarkFlow editors. Each file can be switched individually with the MarkFlow: Toggle Preview Style command."
        },
        "markflow.maxContentWidth": {
          "type": "number",
          "default": 0,
          "description": "Maximum content width in pixels. 0 uses the full editor width."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "npm run build -- --production",
    "package": "npx @vscode/vsce package"
  },
  "dependencies": {
    "@milkdown/crepe": "^7",
    "@milkdown/kit": "^7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "~1.85",
    "esbuild": "^0.24",
    "typescript": "^5"
  }
}
